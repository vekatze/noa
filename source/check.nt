import {
  this.gen {gen},
  this.noa-kit {noa-kit},
  this.noa-kit.check,
}

define-meta check<a>(k: '&noa-kit, label: '&string, !g: 'gen(a), !predicate: '(a) -> bool) -> 'unit {
  quote {
    this.noa-kit.check.check::(
      unquote {k},
      unquote {label},
      unquote {g},
      unquote {predicate},
    )
  }
}
