import {
  core::array {length},
  core::doc {doc},
  core::string.builder {append-string, string-builder},
  this::gen {gen},
  this::suite._engine.replay {replay-and-render, replay-and-test},
  this::suite._kernel.edit {Edit-Float, Edit-Int, Edit-Shift-Mode, apply-edit, edit},
  this::suite._kernel.primitive {
    shrink-target-float,
    shrink-target-int,
  },
  this::suite._kernel.scenario {
    Active,
    Draw-Float,
    Draw-Int,
    Inactive,
    Reset,
    Shift,
    read-event-at,
    scenario,
  },
}

data _shrink-mode {
| _Shrink-Activate
| _Shrink-Fate
}

define _is-nan(x: float) -> bool {
  if eq-float(x, x) {
    False
  } else {
    True
  }
}

define _float-key(x: float) -> int {
  let b = magic cast(float64, int64, x);
  if eq-int(and-int(b, 0x8000000000000000), 0) {
    or-int(b, 0x8000000000000000)
  } else {
    xor-int(b, 0xFFFFFFFFFFFFFFFF)
  }
}

define _key-float(k: int) -> float {
  if eq-int(and-int(k, 0x8000000000000000), 0) {
    magic cast(int64, float64, xor-int(k, 0xFFFFFFFFFFFFFFFF))
  } else {
    magic cast(int64, float64, and-int(k, 0x7FFFFFFFFFFFFFFF))
  }
}

define _avg-key(a: int, b: int) -> int {
  add-int(add-int(lshr-int(a, 1), lshr-int(b, 1)), and-int(and-int(a, b), 1))
}

define _int-key(v: int) -> int {
  xor-int(v, 0x8000000000000000)
}

define _append-shrink-line(b: &string-builder, value: &string) -> unit {
  append-string(b, "    [shrink] ");
  append-string(b, value);
  append-string(b, "\n")
}

define _record-shrink-step<a>(
  tb: &string-builder,
  events: &scenario,
  g: &gen(a),
  render: &(&a) -> doc,
) ->> unit {
  match replay-and-render(events, g, render) {
  | Right(s) =>
    pin s = s;
    _append-shrink-line(tb, s)
  | Left(_) =>
    Unit
  }
}

define _try-candidate<a>(
  events: &scenario,
  g: &gen(a),
  e: edit,
  prop: &(&a) -> bool,
) ->> ?edit {
  let Pair(is-counterexample, e) = replay-and-test(events, g, e, prop);
  if is-counterexample {
    Right(e)
  } else {
    let _ = e;
    none
  }
}

data active-shift {
| Not-Found
| Found(int, int)
}

define _first-active-shift-in-range(ops: &scenario, start: int, end: int) ->> active-shift {
  if ge-int(start, end) {
    Not-Found
  } else {
    case read-event-at(ops, start) {
    | Shift(Active, inner-end) =>
      Found(start, *inner-end)
    | Reset(inner-end) =>
      _first-active-shift-in-range(ops, *inner-end, end)
    | Shift(_, inner-end) =>
      _first-active-shift-in-range(ops, *inner-end, end)
    | _ =>
      _first-active-shift-in-range(ops, add-int(start, 1), end)
    }
  }
}

define _visit-activate<a>(
  ops: &scenario,
  start: int,
  end: int,
  events: &scenario,
  g: &gen(a),
  prop: &(&a) -> bool,
) ->> ?edit {
  match _first-active-shift-in-range(ops, start, end) {
  | Found(index, inner-end) =>
    _visit-activate(ops, add-int(index, 1), inner-end, events, g, prop)
  | Not-Found =>
    let go =
      define loop(index: int) ->> ?edit {
        if ge-int(index, end) {
          none
        } else {
          case read-event-at(ops, index) {
          | Shift(Inactive, inner-end) =>
            match _try-candidate(events, g, Edit-Shift-Mode(index, Active), prop) {
            | Right(found) =>
              Right(found)
            | Left(_) =>
              match _visit-activate(ops, add-int(index, 1), *inner-end, events, g, prop) {
              | Right(found) =>
                Right(found)
              | Left(_) =>
                loop(*inner-end)
              }
            }
          | Reset(inner-end) =>
            match _visit-activate(ops, add-int(index, 1), *inner-end, events, g, prop) {
            | Right(found) =>
              Right(found)
            | Left(_) =>
              loop(*inner-end)
            }
          | Shift(_, inner-end) =>
            match _visit-activate(ops, add-int(index, 1), *inner-end, events, g, prop) {
            | Right(found) =>
              Right(found)
            | Left(_) =>
              loop(*inner-end)
            }
          | _ =>
            loop(add-int(index, 1))
          }
        }
      };
    go(start)
  }
}

define _visit-shrink-fate<a>(
  ops: &scenario,
  start: int,
  end: int,
  events: &scenario,
  g: &gen(a),
  prop: &(&a) -> bool,
) ->> ?edit {
  match _first-active-shift-in-range(ops, start, end) {
  | Found(index, inner-end) =>
    _visit-shrink-fate(ops, add-int(index, 1), inner-end, events, g, prop)
  | Not-Found =>
    let go =
      define loop(index: int) ->> ?edit {
        let try-int-bisect =
          define loop(index: int, fail-key: int, pass-key: int, best: ?edit) ->> ?edit {
            let mid-key = _avg-key(fail-key, pass-key);
            if eq-int(mid-key, fail-key) {
              best
            } else-if eq-int(mid-key, pass-key) {
              best
            } else {
              let mid-value = _int-key(mid-key);
              match _try-candidate(events, g, Edit-Int(index, mid-value), prop) {
              | Right(found) =>
                let _ = best;
                loop(index, mid-key, pass-key, Right(found))
              | Left(_) =>
                loop(index, fail-key, mid-key, best)
              }
            }
          };
        let try-float-bisect =
          define loop(index: int, fail-key: int, pass-key: int, best: ?edit) ->> ?edit {
            let mid-key = _avg-key(fail-key, pass-key);
            if eq-int(mid-key, fail-key) {
              best
            } else-if eq-int(mid-key, pass-key) {
              best
            } else {
              let mid-value = _key-float(mid-key);
              match _try-candidate(events, g, Edit-Float(index, mid-value), prop) {
              | Right(found) =>
                let _ = best;
                loop(index, mid-key, pass-key, Right(found))
              | Left(_) =>
                loop(index, fail-key, mid-key, best)
              }
            }
          };
        if ge-int(index, end) {
          none
        } else {
          case read-event-at(ops, index) {
          | Draw-Int(lo, hi, pivot, value) =>
            let current-value = *value;
            let target = shrink-target-int(*lo, *hi, *pivot);
            if eq-int(current-value, target) {
              loop(add-int(index, 1))
            } else {
              match _try-candidate(events, g, Edit-Int(index, target), prop) {
              | Right(found) =>
                Right(found)
              | Left(_) =>
                match try-int-bisect(index, _int-key(current-value), _int-key(target), none) {
                | Right(found) =>
                  Right(found)
                | Left(_) =>
                  loop(add-int(index, 1))
                }
              }
            }
          | Draw-Float(lo, hi, pivot, value) =>
            let current-value = *value;
            let target = shrink-target-float(*lo, *hi, *pivot);
            if _is-nan(current-value) {
              match _try-candidate(events, g, Edit-Float(index, target), prop) {
              | Right(found) =>
                Right(found)
              | Left(_) =>
                loop(add-int(index, 1))
              }
            } else-if eq-float(current-value, target) {
              loop(add-int(index, 1))
            } else {
              match _try-candidate(events, g, Edit-Float(index, target), prop) {
              | Right(found) =>
                Right(found)
              | Left(_) =>
                match try-float-bisect(index, _float-key(current-value), _float-key(target), none) {
                | Right(found) =>
                  Right(found)
                | Left(_) =>
                  loop(add-int(index, 1))
                }
              }
            }
          | Reset(inner-end) =>
            match _visit-shrink-fate(ops, add-int(index, 1), *inner-end, events, g, prop) {
            | Right(found) =>
              Right(found)
            | Left(_) =>
              loop(*inner-end)
            }
          | Shift(_, inner-end) =>
            match _visit-shrink-fate(ops, add-int(index, 1), *inner-end, events, g, prop) {
            | Right(found) =>
              Right(found)
            | Left(_) =>
              loop(*inner-end)
            }
          | _ =>
            loop(add-int(index, 1))
          }
        }
      };
    go(start)
  }
}

define _try-one-edit<a>(
  events: scenario,
  mode: _shrink-mode,
  verbose: bool,
  g: &gen(a),
  prop: &(&a) -> bool,
  render: &(&a) -> doc,
  tb: &string-builder,
) ->> pair(scenario, bool) {
  let end on events = length(events);
  let found on events =
    match mode {
    | _Shrink-Activate =>
      _visit-activate(events, 0, end, events, g, prop)
    | _Shrink-Fate =>
      _visit-shrink-fate(events, 0, end, events, g, prop)
    };
  match found {
  | Left(_) =>
    Pair(events, False)
  | Right(edit0) =>
    let events1 on edit0 = apply-edit(events, edit0);
    let _ = edit0;
    let _ on events1 =
      if verbose {
        _record-shrink-step(tb, events1, g, render)
      } else {
        Unit
      };
    Pair(events1, True)
  }
}

define _shrink-go<a>(
  events: scenario,
  mode: _shrink-mode,
  verbose: bool,
  g: &gen(a),
  prop: &(&a) -> bool,
  render: &(&a) -> doc,
  tb: &string-builder,
) ->> scenario {
  let second-mode =
    match mode {
    | _Shrink-Activate =>
      _Shrink-Fate
    | _Shrink-Fate =>
      _Shrink-Activate
    };
  let Pair(events1, changed1) = _try-one-edit(events, mode, verbose, g, prop, render, tb);
  if changed1 {
    _shrink-go(events1, mode, verbose, g, prop, render, tb)
  } else {
    let Pair(events2, changed2) = _try-one-edit(events1, second-mode, verbose, g, prop, render, tb);
    if changed2 {
      _shrink-go(events2, second-mode, verbose, g, prop, render, tb)
    } else {
      events2
    }
  }
}

define shrink<a>(
  events: scenario,
  verbose: bool,
  g: &gen(a),
  prop: &(&a) -> bool,
  render: &(&a) -> doc,
  tb: &string-builder,
) ->> scenario {
  _shrink-go(events, _Shrink-Activate, verbose, g, prop, render, tb)
}
