import {
  core.ansi.io {ansi-kit, make-ansi-kit},
  core.file.descriptor {descriptor, stdout},
}

data noa-kit {
| _Noa-Kit(
    ansi-kit: ansi-kit,
    num-of-tests: int,
    max-size: int,
    verbose: bool,
  )
}

define _compute-size(k: &noa-kit, iteration: int) -> int {
  tie _Noa-Kit{num-of-tests, max-size} = k;
  let max-size-float = sitofp-int-float(*max-size);
  let iteration-float = sitofp-int-float(iteration);
  let num-of-tests-float = sitofp-int-float(*num-of-tests);
  let size = mul-float(max-size-float, div-float(iteration-float, num-of-tests-float));
  fptosi-float-int(size)
}

define _get-num-of-tests(k: &noa-kit) -> int {
  tie _Noa-Kit{num-of-tests} = k;
  *num-of-tests
}

define _get-verbose(k: &noa-kit) -> bool {
  tie _Noa-Kit{verbose} = k;
  *verbose
}

define make-noa-kit(
  sink: descriptor,
  buffer-capacity: int,
  num-of-tests: int,
  max-size: int,
  verbose: bool,
) -> noa-kit {
  let ansi-kit = make-ansi-kit(sink, buffer-capacity);
  _Noa-Kit(
    ansi-kit,
    num-of-tests,
    max-size,
    verbose,
  )
}

define make-default-noa-kit() -> noa-kit {
  make-noa-kit{
    sink := stdout,
    buffer-capacity := 4096,
    num-of-tests := 100,
    max-size := 100,
    verbose := False,
  }
}

define make-verbose-noa-kit() -> noa-kit {
  make-noa-kit{
    sink := stdout,
    buffer-capacity := 4096,
    num-of-tests := 100,
    max-size := 100,
    verbose := True,
  }
}
