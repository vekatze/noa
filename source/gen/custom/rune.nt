import {
  core.list {filter},
  core.list.eq {member},
  core.random {random-in-range-int, random-int},
  core.rune,
  core.rune.ord {as-ord},
  this.gen {Gen, gen},
}

define gen-rune-in-range(lower: int, upper: int) -> rune {
  // (inclusive range)
  let value = random-in-range-int(trunc-int-int32(lower), trunc-int-int32(upper));
  match core.rune.from-int(value) {
  | Right(r) =>
    r
  | Left(_) =>
    gen-rune-in-range(lower, upper)
  }
}

define _gen-rune(_: int) -> rune {
  let rune-kind = random-int(4);
  if eq-int(rune-kind, 0) {
    gen-rune-in-range(0, 0x7F)
  } else-if eq-int(rune-kind, 1) {
    gen-rune-in-range(0x0080, 0x07FF)
  } else-if eq-int(rune-kind, 2) {
    gen-rune-in-range(0x0800, 0xFFFF)
  } else {
    gen-rune-in-range(0x10000, 0x10FFFF)
  }
}

constant _simple-runes: list(rune) {
  List[
    `b`,
    `a`,
    `B`,
    `A`,
  ]
}

define _extract-candidates(c: rune) -> list(rune) {
  let cs = _simple-runes;
  let is-elem on c, cs = {
    pin k = core.rune.eq.as-eq;
    member(k, cs, c)
  };
  let _ = cs;
  if is-elem {
    let pred =
      (cand) => {
        let Ord{compare} = as-ord;
        let b on c = compare(c, cand);
        let _ = c;
        match b {
        | GT =>
          True
        | _ =>
          False
        }
      };
    filter(_simple-runes, pred)
  } else {
    List[`A`]
  }
}

data config {
| Config(
    rune-generator: ?() -> rune,
    rune-acceptor: (rune) -> bool,
  )
}

inline rune-gen(!c: config) -> gen(rune) {
  let Config{rune-generator := !generator, rune-acceptor := !acceptor} = c;
  Gen{
    generate := {
      define loop(size: int) -> rune {
        let cand =
          match generator {
          | Right(g) =>
            g()
          | Left(_) =>
            _gen-rune(size)
          };
        if acceptor(cand) {
          cand
        } else {
          loop(size)
        }
      }
    },
    shrink := {
      (v) => {
        let cands = _extract-candidates(v);
        filter(cands, (cand) => {
          acceptor(*cand)
        })
      }
    },
  }
}
