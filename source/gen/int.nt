import {
  this::gen {Gen, gen},
  this::suite {gen-kit},
  this::suite.combinator {choose, draw-int},
}

inline gen-int(lo: int, hi: int, pivot: int) -> gen(int) {
  Gen(
    <r>(k: &gen-kit) =>> {
      draw-int<r>(k, lo, hi, pivot)
    },
  )
}

inline gen-choose(n: int) -> gen(int) {
  Gen(
    <r>(k: &gen-kit) =>> {
      choose<r>(k, n)
    },
  )
}
