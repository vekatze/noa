import {
  core.control {grow},
  core.random {random-int},
  this.gen {Gen, draw, gen},
  this.gen._list {shrink-list},
}

inline list-gen<a>(!g: gen(a)) -> gen(list(a)) {
  Gen{
    generate := {
      (size) => {
        let trunc-size = trunc-int-int32(size);
        grow(Nil, size, (acc, _) => {
          let elem = draw(random-int(trunc-size), g);
          Cons(elem, acc)
        })
      }
    },
    shrink := shrink-list(g),
  }
}
