import {
  this::control {Control-Success, control, control-bind},
  this::gen {Gen, apply, gen},
  this::suite {gen-kit},
  this::suite.combinator {cut, draw-continue, scope},
}

constant _continue-fanout: int {
  8
}

define _list-go<a>(!elem: gen(a), k: &gen-kit) ->> control(list(a), list(a)) {
  scope<list(a), list(a)>(k, (k) =>> {
    with control-bind {
      bind more = draw-continue<list(a)>(k, _continue-fanout);
      if eq-int(more, 0) {
        Control-Success(Nil)
      } else {
        bind x = apply(elem, k);
        bind rest =
          cut(k, (k) =>> {
            _list-go(elem, k)
          });
        Control-Success(Cons(x, rest))
      }
    }
  })
}

define gen-list<a>(elem: gen(a)) -> gen(list(a)) {
  Gen(
    <r>(k: &gen-kit) =>> {
      scope<r, list(a)>(k, (k) =>> {
        _list-go(elem, k)
      })
    },
  )
}
