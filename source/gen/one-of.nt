import {
  core::list {length},
  this::control {Control-Success, control-bind},
  this::gen {Gen, gen},
  this::suite {gen-kit},
  this::suite.combinator {choose},
}

define _list-nth<a>(xs: list(a), i: int) -> a {
  match xs {
  | Nil =>
    panic("one-of: index out of range")
  | Cons(x, rest) =>
    if eq-int(i, 0) {
      let _ = rest;
      x
    } else {
      let _ = x;
      _list-nth(rest, sub-int(i, 1))
    }
  }
}

define one-of<a>(values: list(a)) -> gen(a) {
  Gen(
    <r>(k: &gen-kit) =>> {
      let n on values = length(values);
      with control-bind {
        bind i = choose<r>(k, n);
        Control-Success(_list-nth(values, i))
      }
    },
  )
}
