import {
  core.doc {
    Chunk,
    Chunk-Choose,
    Chunk-Empty,
    Chunk-Join,
    Chunk-Line,
    Chunk-Style,
    Chunk-Style-N,
    Group,
    Nest,
    Seq,
    chunk,
    doc,
  },
  core.doc.show {show-doc},
  core.show.generic {to-doc},
  core.string {replace},
  this.gen {Gen, draw, gen},
  this.noa-kit {_compute-size, _get-num-of-tests, _get-verbose, noa-kit},
  this.noa-kit._report {flush, print-blue-bold, print-green-bold, print-red-bold, write, write-line},
}

data _result(a) {
| _OK
| _Failure(
    iteration: int,
    value: a,
    predicate: (a) -> bool,
    g: gen(a),
    verbose: bool,
  )
}

define _simplify-chunk(x: chunk) -> chunk {
  match x {
  | Chunk-Line =>
    Chunk-Empty
  | Chunk-Join(left, right) =>
    Chunk-Join(_simplify-chunk(left), _simplify-chunk(right))
  | Chunk-Choose(horizontal, _) =>
    horizontal
  | Chunk-Style(_) =>
    Chunk-Empty
  | Chunk-Style-N(_) =>
    Chunk-Empty
  | x =>
    x
  }
}

define _simplify-doc(d: doc) -> doc {
  match d {
  | Chunk(c) =>
    Chunk(_simplify-chunk(c))
  | Seq(d1, d2) =>
    Seq(_simplify-doc(d1), _simplify-doc(d2))
  | Nest(i, d) =>
    Nest(i, _simplify-doc(d))
  | Group(d) =>
    Group(_simplify-doc(d))
  }
}

constant _max-ribbon-length: int {
  32
}

define _find-refutation<a>(
  k: &noa-kit,
  !predicate: (a) -> bool,
  !vd: &(&a) -> doc,
  cands: list(a),
  !g: gen(a),
) -> ?a {
  let verbose = _get-verbose(k);
  match cands {
  | Nil =>
    when verbose {
      print-blue-bold(k, "    ✓ Stop\n")
    };
    none
  | Cons(!cand, rest) =>
    if predicate(cand) {
      when verbose {
        print-blue-bold(k, "      ✓ ");
        pin cand = cand;
        pin d = _simplify-doc(vd(cand));
        pin t = show-doc(d, _max-ribbon-length);
        write-line(k, t);
      };
      _find-refutation(k, predicate, vd, rest, g)
    } else {
      when verbose {
        print-red-bold(k, "      ✗ ");
        pin cand = cand;
        pin d = _simplify-doc(vd(cand));
        pin t = show-doc(d, _max-ribbon-length);
        print-red-bold(k, t);
        write(k, "\n");
      };
      Right(cand)
    }
  }
}

define _repeat-shrink<a>(
  k: &noa-kit,
  !cand: a,
  !predicate: (a) -> bool,
  !vd: &(&a) -> doc,
  !g: gen(a),
) -> a {
  let Gen{shrink} = g;
  let alts = shrink(cand);
  match _find-refutation(k, predicate, vd, alts, g) {
  | Left(_) =>
    cand
  | Right(smaller-cand) =>
    _repeat-shrink(k, smaller-cand, predicate, vd, g)
  }
}

inline _run-tests<a>(
  k: &noa-kit,
  num-of-tests: int,
  !f: (int) -> _result(a),
  !vd: &(&a) -> doc,
) -> either(pair(int, a), unit) {
  let helper =
    define self(iteration: int) -> either(pair(int, a), unit) {
      if ge-int(iteration, num-of-tests) {
        Right(Unit)
      } else {
        match f(iteration) {
        | _OK =>
          self(add-int(iteration, 1))
        | _Failure{iteration, value, predicate, g, verbose} =>
          when verbose {
            print-blue-bold(k, "    ↻ Shrink:\n")
          };
          let next-value = _repeat-shrink(k, value, predicate, vd, g);
          Left(Pair(iteration, next-value))
        }
      }
    };
  helper(0)
}

define _check-inner<a>(k: &noa-kit, label: &string, !g: gen(a), !predicate: (a) -> bool, !vd: &(&a) -> doc) -> unit {
  let verbose = _get-verbose(k);
  let num-of-tests = _get-num-of-tests(k);
  let result = {
    when verbose {
      print-blue-bold(k, "? Check: ");
      write-line(k, label);
    };
    _run-tests(
      k,
      num-of-tests,
      (i) => {
        let size = _compute-size(k, i);
        let !value = draw(size, g);
        if predicate(value) {
          when verbose {
            print-blue-bold(k, "  ✓ ");
            pin cand = value;
            pin d = _simplify-doc(vd(cand));
            pin t = show-doc(d, _max-ribbon-length);
            write-line(k, t);
          };
          _OK
        } else {
          when verbose {
            print-red-bold(k, "  ✗ ");
            pin cand = value;
            pin d = _simplify-doc(vd(cand));
            pin t = show-doc(d, _max-ribbon-length);
            print-red-bold(k, t);
            write(k, "\n");
          };
          _Failure(i, value, predicate, g, verbose)
        }
      },
      vd,
    )
  };
  match result {
  | Right(Unit) =>
    print-green-bold(k, "✓ Pass: ");
    write-line(k, label)
  | Left(Pair(_, counterexample)) =>
    print-red-bold(k, "✗ Fail: ");
    write-line(k, label);
    print-red-bold(k, "  → ");
    pin !cand = counterexample;
    pin d = _simplify-doc(vd(cand));
    pin txt = show-doc(d, _max-ribbon-length);
    pin txt = replace(txt, "\n", *"\n    ");
    print-red-bold(k, txt);
    write(k, "\n");
  };
  flush(k)
}

define-meta check<a>(k: '&noa-kit, label: '&string, !g: 'gen(a), !predicate: '(a) -> bool) -> 'unit {
  quote {
    let k = unquote {k};
    let label = unquote {label};
    let !g = unquote {g};
    let !predicate = unquote {predicate};
    pin f =
      (v: &a) => {
        to-doc::(v)
      };
    _check-inner(k, label, g, predicate, f)
  }
}
