{
  target {
    test {
      main "_test.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    test-wasm {
      main "_test.nt",
      platform "wasm32",
      execute [
        "wasmtime",
        "{{executable}}",
      ],
    },
  },
  dependency {
    core {
      digest "Qe2KnYyyiHFOtvqExQep5NplSMDmd-BwVUOweR0MpXA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.7.tar.zst",
      ],
      enable-preset true,
    },
  },
}
