{
  target {
    test {
      main "_test.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    test-wasm {
      main "_test.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
  },
  dependency {
    core {
      digest "AV5wq2fmffFFvabWuGMEgHXG-jXf543FE_rDYNlWxm0",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.9.tar.zst",
      ],
      enable-preset true,
    },
  },
}
